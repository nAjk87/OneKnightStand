        {PPUDATA}((water_chr_pixels[15] & narrow_top_mask[7]) | (narrow_top_pixels[15] & narrow_row_7))

        ppu_reset_addr(UU($1180) + UU(frame_offset))
        {PPUDATA}((water_chr_pixels[0] & narrow_body_mask[0]) | (narrow_body_pixels[0] & narrow_row_0))
        {PPUDATA}((water_chr_pixels[1] & narrow_body_mask[1]) | (narrow_body_pixels[1] & narrow_row_1))
        {PPUDATA}((water_chr_pixels[2] & narrow_body_mask[2]) | (narrow_body_pixels[2] & narrow_row_2))
        {PPUDATA}((water_chr_pixels[3] & narrow_body_mask[3]) | (narrow_body_pixels[3] & narrow_row_3))
        {PPUDATA}((water_chr_pixels[4] & narrow_body_mask[4]) | (narrow_body_pixels[4] & narrow_row_4))
        {PPUDATA}((water_chr_pixels[5] & narrow_body_mask[5]) | (narrow_body_pixels[5] & narrow_row_5))
        {PPUDATA}((water_chr_pixels[6] & narrow_body_mask[6]) | (narrow_body_pixels[6] & narrow_row_6))
        {PPUDATA}((water_chr_pixels[7] & narrow_body_mask[7]) | (narrow_body_pixels[7] & narrow_row_7))
        {PPUDATA}((water_chr_pixels[8] & narrow_body_mask[0]) | (narrow_body_pixels[8] & narrow_row_0))
        {PPUDATA}((water_chr_pixels[9] & narrow_body_mask[1]) | (narrow_body_pixels[9] & narrow_row_1))
        {PPUDATA}((water_chr_pixels[10] & narrow_body_mask[2]) | (narrow_body_pixels[10] & narrow_row_2))
        {PPUDATA}((water_chr_pixels[11] & narrow_body_mask[3]) | (narrow_body_pixels[11] & narrow_row_3))
