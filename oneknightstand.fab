

mapfab(raw, "yee2.mapfab", "chr", "palette", "metatiles", "level")
// PUF still needs its silent music definitions when only sound effects are used.
audio(puf1_music)
audio(puf1_sfx, "audio/kill.txt", "audio/kill.nsf")

