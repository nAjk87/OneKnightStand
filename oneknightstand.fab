        {PPUDATA}(outlet_chr_pixels[15])

        ppu_reset_addr(UU($1100) + UU(frame_offset))
        {PPUDATA}((water_chr_pixels[0] & narrow_top_mask[0]) | (narrow_top_pixels[0] & narrow_row_0))
