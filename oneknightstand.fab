/*
Loads one screen from a column-major map with a 16-metatile row stride.
The visible screen is 32x30 background tiles.
*/
fn load_screen(CCC/levels my_lvl_pointer)
    U chr_bank = read U(my_lvl_pointer)
    CCC/palettes pal=read CCC/palettes(my_lvl_pointer)
    CC/metatiles mymetatiles=@mt_metatiles
    UU size = UU(read U(my_lvl_pointer)) // Consume stored width; this loader draws a fixed 16 columns.
    //after all these reads, now my_lvl_pointer points to the metatiles matrix

    // Mapper 30 uses CHR-RAM, so CHR must be copied into the PPU at runtime.
    {PPUMASK}(0)
    state(M30_CHR(chr_bank))
    {PPUCTRL}(0)
    ppu_reset_addr($0000)
    ppu_upload_pbz.tiles(@chr_chr, 0)
    ppu_reset_addr($1000)
    ppu_upload_pbz.tiles(@chr_chr, 0)
    state(M30_CHR(chr_bank))
    load_water_chr_tile()

    // set palette
    load_palette(pal)
    store_base_palette()
    ppu_upload_palette()
       
    UU mt_size = UU(read U(mymetatiles)) // number of metatiles
    if mt_size == 0
        mt_size = 256

    lvl1_mt_map=my_lvl_pointer // the map is set in columns. it's in level.macrofab
    
    mt_nw=mymetatiles
    mt_ne=mt_nw
    mt_ne+=mt_size
    mt_sw=mt_ne
    mt_sw+=mt_size
    mt_se=mt_sw
    mt_se+=mt_size
    mt_attr=mt_se
    mt_attr+=mt_size
    // now every pointer points where it should
    build_collision_map()

    ppu_reset_addr($2000) // first screen // https://www.nesdev.org/wiki/Mirroring

    {PPUSTATUS}() // Reset the address latch before 'ppu_set_addr', just to be safe.
    {PPUCTRL}(PPUCTRL_VRAM_32_DOWN) // Used to write columns of data.

    // Upload the nametable.
    UU i=0
    UU ii=0

    for UU x=0; x<16; x+=1
        ppu_reset_addr($2000+ii)
        for UU y=0; y<16; y+=1
            U my_metatile=my_lvl_pointer{i}
            U nw_tile=mt_nw[my_metatile]
            U sw_tile=mt_sw[my_metatile]
            {PPUDATA}(nw_tile)
            {PPUDATA}(sw_tile)
            i+=1
        i-=16
        ii+=1
        ppu_reset_addr($2000+ii)
        for UU y=0; y<16; y+=1
            U my_metatile=my_lvl_pointer{i}
            U ne_tile=mt_ne[my_metatile]
            U se_tile=mt_se[my_metatile]
            {PPUDATA}(ne_tile)
            {PPUDATA}(se_tile)
            i+=1
        ii+=1

    //upload first attributes data, we need to OR it together
    //for every 2x2 metatiles block (https://www.nesdev.org/wiki/PPU_attribute_tables)
    i=0
    ii=0
    for UU a=0; a<8; a+=1
        for UU attri=0; attri<32; attri+=8
            ppu_reset_addr($2000+960+a+attri)
            U my_metatile=my_lvl_pointer{i} //tl
            U my_attr=mt_attr[my_metatile]
            //
            my_metatile=my_lvl_pointer{i+16} // tr
            my_attr|=(mt_attr[my_metatile]<<2)
            //
            my_metatile=my_lvl_pointer{i+1} //bl
            my_attr|=(mt_attr[my_metatile]<<4)
            //
            my_metatile=my_lvl_pointer{i+17} //br
            my_attr|=(mt_attr[my_metatile]<<6)
            //
            {PPUDATA}(my_attr)
            //
            my_metatile=my_lvl_pointer{i+8} //tl
            my_attr=mt_attr[my_metatile]
            //
            my_metatile=my_lvl_pointer{i+16+8} // tr
            my_attr|=(mt_attr[my_metatile]<<2)
            //
            my_metatile=my_lvl_pointer{i+1+8} //bl
            my_attr|=(mt_attr[my_metatile]<<4)
            //
            my_metatile=my_lvl_pointer{i+17+8} //br
            my_attr|=(mt_attr[my_metatile]<<6)
            //
            {PPUDATA}(my_attr)
            i+=2
        ii+=32
        i=ii

    if on_title_screen
        {PPUCTRL}(0) // Restore horizontal PPU increment after the column loader.
        ppu_reset_addr(TITLE_CPU_STATUS_ADDR)
        {PPUDATA}()
        title_cpu_background[0] = {PPUDATA}()
        title_cpu_background[1] = {PPUDATA}()
        title_cpu_background[2] = {PPUDATA}()
        title_cpu_background[3] = {PPUDATA}()
        title_cpu_background[4] = {PPUDATA}()
        title_cpu_background[5] = {PPUDATA}()
        title_cpu_dirty = true

fn upload_title_cpu_status()
    if !on_title_screen || !title_cpu_dirty
        return
    title_cpu_dirty = false
    ppu_reset_addr(TITLE_CPU_STATUS_ADDR)
    if bot_mode_enabled
        {PPUDATA}(195) // C: PNG x24, y96.
        {PPUDATA}(208) // P: PNG x0, y104.
        {PPUDATA}(213) // U: PNG x40, y104.
        {PPUDATA}(255) // Blank tile.
        {PPUDATA}(207) // O: PNG x120, y96.
        {PPUDATA}(206) // N: PNG x112, y96.
    else
        {PPUDATA}(title_cpu_background[0])
        {PPUDATA}(title_cpu_background[1])
        {PPUDATA}(title_cpu_background[2])
        {PPUDATA}(title_cpu_background[3])
        {PPUDATA}(title_cpu_background[4])
        {PPUDATA}(title_cpu_background[5])

fn upload_title_join_count()
    if !on_title_screen
        return

    if !title_join_dirty
        return

    title_join_dirty = false

    ppu_reset_addr($21D1)

    if title_join_count == 0
        {PPUDATA}(TITLE_JOIN_COUNT_TILE_0)
    else
        {PPUDATA}(TITLE_JOIN_COUNT_TILE_1 + title_join_count - U(1))

fn upload_title_stage_number()
    if !on_title_screen
        return

    if !title_stage_dirty
        return

    title_stage_dirty = false

    ppu_reset_addr(TITLE_STAGE_COUNT_ADDR)
    {PPUDATA}(TITLE_STAGE_TILE_1 + title_selected_stage - U(1))


// Cache the water patterns and silhouettes while rendering is disabled.
fn load_water_chr_tile()
    water_chr_timer = 0
    narrow_water_chr_timer = 0
    ppu_reset_addr($0E60)
    {PPUDATA}() // Discard the PPU read buffer before reading CHR.
    water_chr_pixels[0] = {PPUDATA}()
    water_chr_pixels[1] = {PPUDATA}()
    water_chr_pixels[2] = {PPUDATA}()
    water_chr_pixels[3] = {PPUDATA}()
    water_chr_pixels[4] = {PPUDATA}()
    water_chr_pixels[5] = {PPUDATA}()
    water_chr_pixels[6] = {PPUDATA}()
    water_chr_pixels[7] = {PPUDATA}()
    water_chr_pixels[8] = {PPUDATA}()
    water_chr_pixels[9] = {PPUDATA}()
    water_chr_pixels[10] = {PPUDATA}()
    water_chr_pixels[11] = {PPUDATA}()
    water_chr_pixels[12] = {PPUDATA}()
    water_chr_pixels[13] = {PPUDATA}()
    water_chr_pixels[14] = {PPUDATA}()
    water_chr_pixels[15] = {PPUDATA}()

    narrow_top_pixels[0] = water_chr_pixels[0]
    narrow_top_pixels[1] = water_chr_pixels[1]
    narrow_top_pixels[2] = water_chr_pixels[2]
    narrow_top_pixels[3] = water_chr_pixels[3]
    narrow_top_pixels[4] = water_chr_pixels[4]
    narrow_top_pixels[5] = water_chr_pixels[5]
    narrow_top_pixels[6] = water_chr_pixels[6]
    narrow_top_pixels[7] = water_chr_pixels[7]
