// Sprite slots 0..47 in the second pattern table are unused by other sprites.
// Prepare all pixels at screen load; gameplay only selects cached tile numbers.
fn prepare_water_chr_frames()
    for U phase = 0; phase < 8; phase += 1
        U frame_offset = phase << 4
        U narrow_row_0 = (water_chr_pixels[0] | water_chr_pixels[8]) ^ U(255)
        U narrow_row_1 = (water_chr_pixels[1] | water_chr_pixels[9]) ^ U(255)
        U narrow_row_2 = (water_chr_pixels[2] | water_chr_pixels[10]) ^ U(255)
        U narrow_row_3 = (water_chr_pixels[3] | water_chr_pixels[11]) ^ U(255)
        U narrow_row_4 = (water_chr_pixels[4] | water_chr_pixels[12]) ^ U(255)
        U narrow_row_5 = (water_chr_pixels[5] | water_chr_pixels[13]) ^ U(255)
        U narrow_row_6 = (water_chr_pixels[6] | water_chr_pixels[14]) ^ U(255)
        U narrow_row_7 = (water_chr_pixels[7] | water_chr_pixels[15]) ^ U(255)
        U pipe_row_0 = (outlet_chr_pixels[0] | outlet_chr_pixels[8]) ^ U(255)
        U pipe_row_1 = (outlet_chr_pixels[1] | outlet_chr_pixels[9]) ^ U(255)
        U pipe_row_2 = (outlet_chr_pixels[2] | outlet_chr_pixels[10]) ^ U(255)
        U pipe_row_3 = (outlet_chr_pixels[3] | outlet_chr_pixels[11]) ^ U(255)
        U pipe_row_4 = (outlet_chr_pixels[4] | outlet_chr_pixels[12]) ^ U(255)
        U pipe_row_5 = (outlet_chr_pixels[5] | outlet_chr_pixels[13]) ^ U(255)
        U pipe_row_6 = (outlet_chr_pixels[6] | outlet_chr_pixels[14]) ^ U(255)
        U pipe_row_7 = (outlet_chr_pixels[7] | outlet_chr_pixels[15]) ^ U(255)
        U flow_row_0 = (flow_chr_pixels[0] | flow_chr_pixels[8]) ^ U(255)
        U flow_row_1 = (flow_chr_pixels[1] | flow_chr_pixels[9]) ^ U(255)
        U flow_row_2 = (flow_chr_pixels[2] | flow_chr_pixels[10]) ^ U(255)
        U flow_row_3 = (flow_chr_pixels[3] | flow_chr_pixels[11]) ^ U(255)
        U flow_row_4 = (flow_chr_pixels[4] | flow_chr_pixels[12]) ^ U(255)
        U flow_row_5 = (flow_chr_pixels[5] | flow_chr_pixels[13]) ^ U(255)
        U flow_row_6 = (flow_chr_pixels[6] | flow_chr_pixels[14]) ^ U(255)
        U flow_row_7 = (flow_chr_pixels[7] | flow_chr_pixels[15]) ^ U(255)

        ppu_reset_addr(UU($1000) + UU(frame_offset))
        {PPUDATA}((outlet_chr_pixels[0] & pipe_chr_mask[0]) | (pipe_chr_pixels[0] & pipe_row_0))
        {PPUDATA}((outlet_chr_pixels[1] & pipe_chr_mask[1]) | (pipe_chr_pixels[1] & pipe_row_1))
        {PPUDATA}((outlet_chr_pixels[2] & pipe_chr_mask[2]) | (pipe_chr_pixels[2] & pipe_row_2))
        {PPUDATA}((outlet_chr_pixels[3] & pipe_chr_mask[3]) | (pipe_chr_pixels[3] & pipe_row_3))
        {PPUDATA}((outlet_chr_pixels[4] & pipe_chr_mask[4]) | (pipe_chr_pixels[4] & pipe_row_4))
        {PPUDATA}((outlet_chr_pixels[5] & pipe_chr_mask[5]) | (pipe_chr_pixels[5] & pipe_row_5))
        {PPUDATA}((outlet_chr_pixels[6] & pipe_chr_mask[6]) | (pipe_chr_pixels[6] & pipe_row_6))
        {PPUDATA}((outlet_chr_pixels[7] & pipe_chr_mask[7]) | (pipe_chr_pixels[7] & pipe_row_7))
        {PPUDATA}((outlet_chr_pixels[8] & pipe_chr_mask[0]) | (pipe_chr_pixels[8] & pipe_row_0))
        {PPUDATA}((outlet_chr_pixels[9] & pipe_chr_mask[1]) | (pipe_chr_pixels[9] & pipe_row_1))
        {PPUDATA}((outlet_chr_pixels[10] & pipe_chr_mask[2]) | (pipe_chr_pixels[10] & pipe_row_2))
        {PPUDATA}((outlet_chr_pixels[11] & pipe_chr_mask[3]) | (pipe_chr_pixels[11] & pipe_row_3))
        {PPUDATA}((outlet_chr_pixels[12] & pipe_chr_mask[4]) | (pipe_chr_pixels[12] & pipe_row_4))
        {PPUDATA}((outlet_chr_pixels[13] & pipe_chr_mask[5]) | (pipe_chr_pixels[13] & pipe_row_5))
        {PPUDATA}((outlet_chr_pixels[14] & pipe_chr_mask[6]) | (pipe_chr_pixels[14] & pipe_row_6))
        {PPUDATA}((outlet_chr_pixels[15] & pipe_chr_mask[7]) | (pipe_chr_pixels[15] & pipe_row_7))

        ppu_reset_addr(UU($1080) + UU(frame_offset))
        {PPUDATA}(outlet_chr_pixels[0])
