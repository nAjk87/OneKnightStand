        {PPUDATA}((water_chr_pixels[2] & narrow_top_mask[2]) | (narrow_top_pixels[2] & narrow_row_2))
        {PPUDATA}((water_chr_pixels[3] & narrow_top_mask[3]) | (narrow_top_pixels[3] & narrow_row_3))
        {PPUDATA}((water_chr_pixels[4] & narrow_top_mask[4]) | (narrow_top_pixels[4] & narrow_row_4))
        {PPUDATA}((water_chr_pixels[5] & narrow_top_mask[5]) | (narrow_top_pixels[5] & narrow_row_5))
        {PPUDATA}((water_chr_pixels[6] & narrow_top_mask[6]) | (narrow_top_pixels[6] & narrow_row_6))
        {PPUDATA}((water_chr_pixels[7] & narrow_top_mask[7]) | (narrow_top_pixels[7] & narrow_row_7))
        {PPUDATA}((water_chr_pixels[8] & narrow_top_mask[0]) | (narrow_top_pixels[8] & narrow_row_0))
