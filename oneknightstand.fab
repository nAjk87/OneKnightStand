        {PPUDATA}((water_chr_pixels[11] & narrow_top_mask[3]) | (narrow_top_pixels[11] & narrow_row_3))
        {PPUDATA}((water_chr_pixels[12] & narrow_top_mask[4]) | (narrow_top_pixels[12] & narrow_row_4))
        {PPUDATA}((water_chr_pixels[13] & narrow_top_mask[5]) | (narrow_top_pixels[13] & narrow_row_5))
